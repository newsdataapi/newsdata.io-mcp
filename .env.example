# NewsData.io credentials — copy this file to `.env` and fill in.
NEWSDATA_API_KEY="your_newsdata_api_key_here"

# Optional: request timeout in seconds (default: 30)
# REQUEST_TIMEOUT=30

# Optional: override the API base URL (e.g. for staging or a local mock).
# Keep the version segment at the end, as in the default below.
# NEWSDATA_BASE_URL=https://newsdata.io/api/2

# Optional: retry policy for transient failures (network, 5xx, 429).
# Defaults: up to 5 attempts, sleeping 2s, 4s, 8s, 16s between them (each sleep capped at 60s).
# When the API itself asks for a wait longer than NEWSDATA_RETRY_BACKOFF_MAX (a rate-limit
# window can be minutes away), the error is returned at once instead of waiting.
# NEWSDATA_MAX_RETRIES=5
# NEWSDATA_RETRY_BACKOFF=2.0
# NEWSDATA_RETRY_BACKOFF_MAX=60.0

# Optional: real-time (WebSocket) settings.
# API root of the real-time registration endpoints (register, list, delete). The
# same root as NEWSDATA_BASE_URL by default; set it to send them somewhere else.
# NEWSDATA_WS_API_URL=https://newsdata.io/api/2
# WebSocket endpoint used by the `stream_news` tool.
# NEWSDATA_WS_URL=wss://ws.newsdata.io/ws/event
# Ceiling on stream_news's wait_seconds, in seconds (default: 120)
# NEWSDATA_WS_MAX_WAIT=120
